{
  "realm": "smartcast",
  "enabled": true,
  "displayName": "Smartcast",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Слушатель" },
      { "name": "AUTHOR", "description": "Автор" },
      { "name": "MODERATOR", "description": "Модератор" },
      { "name": "ADMIN", "description": "Администратор" }
    ]
  },
  "clients": [
    {
      "clientId": "smartcast-client",
      "name": "Smartcast API",
      "enabled": true,
      "publicClient": false,
      "secret": "CHANGE_ME_SECRET",
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/*",
        "http://localhost:5173/*",
        "http://localhost:5173/"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],

      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "smartcast-admin",
      "name": "Smartcast Admin",
      "enabled": true,
      "publicClient": false,
      "secret": "SHOCgvs6fkpTVTf2NDXNfa3Omk73VnK3srgkaMVbhoSKLLOJ8oCF0RRJvAF3Y4EqAFWwEXnO7x7zJltSU8fXYO",
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],

  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "AUTHOR"]
    },
    {
      "username": "testmoderator",
      "enabled": true,
      "email": "testmoderator@example.com",
      "firstName": "Test",
      "lastName": "Moderator",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "moderatorpass",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "MODERATOR"]
    }
  ]
}
